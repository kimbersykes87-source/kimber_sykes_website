# Public site URL (no trailing slash). JSON-LD, sitemap, robots, metadataBase.
NEXT_PUBLIC_SITE_URL=https://kimbersykes.com

# Cloudflare Web Analytics — token from dashboard → Web Analytics → Add a site → JS snippet.
# @see https://developers.cloudflare.com/web-analytics/get-started/
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Large portfolio PDF exceeds Cloudflare Pages ~25 MiB static file limit. Hosted on assets.kimbersykes.com
# (R2 + workers/assets). Omit to use that URL automatically when NEXT_PUBLIC_SITE_URL is kimbersykes.com.
# Override only if you use a different path or host.
NEXT_PUBLIC_PORTFOLIO_PDF_URL=https://assets.kimbersykes.com/portfolio/kimber-sykes-professional-portfolio-2026.pdf

# Resend API key for workers/weekly-report (Worker secret, not Pages):
#   npx wrangler secret put RESEND_API_KEY --config workers/weekly-report/wrangler.toml
# RESEND_API_KEY=
# Optional manual test trigger (Worker secret):
#   npx wrangler secret put MANUAL_TRIGGER_SECRET --config workers/weekly-report/wrangler.toml

# Cloudflare Pages Function /api/kimber-now (used by the /where "Right Now" section).
# Configure these in Cloudflare Pages → Settings → Environment variables (NOT prefixed with NEXT_PUBLIC).
# Defaults bake in the deployed GPS_Tracker worker + device id, so these are optional unless you rotate them.
KIMBER_GPS_WORKER_URL=https://gps-tracker.kimbersykes87.workers.dev
KIMBER_GPS_USER_ID=device_26a4f9dd
# Only set this if your GPS_Tracker worker requires X-API-Key on /api/points (currently unauthenticated).
KIMBER_GPS_API_KEY=
